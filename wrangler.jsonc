{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "food-review",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "food-review-db",
      "database_id": "7b654c5e-7f67-43b2-a9c5-1e6dbb0d743a",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "food-review-photos"
    }
  ],
  "observability": {
    "enabled": true
  }
}
